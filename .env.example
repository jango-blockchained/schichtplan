# Development Environment Variables
# Copy this to .env.local for development

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=src.backend.app:create_app

# Database Configuration
DATABASE_URL=postgresql://schichtplan_user:schichtplan_password@localhost:5432/schichtplan
SQLALCHEMY_ECHO=0

# Redis Configuration
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# Security (Change these in production!)
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=1

# MCP Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=sse
MCP_DEBUG=1

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Email Configuration (if needed)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=

# AI/LLM Configuration (optional)
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
GOOGLE_API_KEY=your-api-key-here

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_DEBUG=1

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Feature Flags
ENABLE_MCP_INTEGRATION=true
ENABLE_CONVERSATIONAL_AI=true
ENABLE_PDF_EXPORT=true
ENABLE_AUDIT_LOGGING=true

# Performance
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_PRE_PING=true
WORKERS=4
WORKER_CLASS=sync
WORKER_TIMEOUT=120

# Development Tools
ENABLE_PROFILING=0
ENABLE_QUERY_LOGGING=0
