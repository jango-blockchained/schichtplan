{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start MCP Server (STDIO)",
			"type": "shell",
			"command": "./src/backend/.venv/bin/python",
			"args": [
				"src/backend/mcp_server.py",
				"--transport",
				"stdio"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"FLASK_ENV": "development",
					"FLASK_APP": "src.backend.app:create_app"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Conversational MCP (STDIO)",
			"type": "shell",
			"command": "./src/backend/.venv/bin/python",
