			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"FLASK_ENV": "development",
					"FLASK_APP": "src.backend.app:create_app"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start MCP Server (HTTP)",
