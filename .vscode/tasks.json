			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"FLASK_ENV": "development"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start MCP Server (SSE)",
			"type": "shell",
			"command": "./src/backend/.venv/bin/python",
			"args": [
				"src/backend/mcp_server.py",
				"--transport",
				"sse",
				"--port",
				"8001"
			],
			"group": "build",
			"presentation": {
				"echo": true,
