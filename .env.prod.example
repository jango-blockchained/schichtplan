# Production Environment Variables
# Copy this to .env.prod for production deployment

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=src.backend.app:create_app

# Database Configuration
DATABASE_URL=postgresql://schichtplan_user:YOUR_SECURE_PASSWORD@postgres:5432/schichtplan
SQLALCHEMY_ECHO=0

# Redis Configuration
REDIS_URL=redis://:YOUR_SECURE_REDIS_PASSWORD@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD
REDIS_DB=0

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=YOUR_VERY_LONG_RANDOM_SECRET_KEY_HERE
JWT_SECRET_KEY=YOUR_VERY_LONG_RANDOM_JWT_KEY_HERE
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=604800

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=0

# MCP Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=sse
MCP_DEBUG=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10

# Email Configuration (configure for your email provider)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# AI/LLM Configuration
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=your-key
GOOGLE_API_KEY=your-key

# Frontend Configuration
FRONTEND_URL=https://your-domain.com
FRONTEND_DEBUG=0

# CORS Configuration
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Feature Flags
ENABLE_MCP_INTEGRATION=true
ENABLE_CONVERSATIONAL_AI=true
ENABLE_PDF_EXPORT=true
ENABLE_AUDIT_LOGGING=true

# Performance
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_PRE_PING=true
WORKERS=8
WORKER_CLASS=sync
WORKER_TIMEOUT=120
WORKER_CONNECTIONS=1000

# Security
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true

# Development Tools (disable in production)
ENABLE_PROFILING=0
ENABLE_QUERY_LOGGING=0
