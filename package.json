{
  "name": "schichtplan-root",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "format:backend": "black .",
    "lint:backend:style": "black --check .",
    "lint:backend:flake8": "flake8 src/backend",
    "lint:backend:mypy": "mypy src/backend",
    "lint:backend": "npm run lint:backend:style && npm run lint:backend:flake8 && npm run lint:backend:mypy",
    "format:frontend": "cd src/frontend && bun run format",
    "lint:frontend": "cd src/frontend && bun run lint",
    "format": "npm run format:backend && npm run format:frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "check:all": "npm run lint && cd src/frontend && bun run typecheck",
    "test:backend": "pytest -v -s tests/backend/",
    "test:frontend": "cd src/frontend && bun test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:smoke": "playwright test e2e/tests/smoke.spec.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "build": "cd src/frontend && tsc && vite build",
    "build:frontend": "cd src/frontend && tsc && vite build",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build:frontend && electron-builder",
    "electron:build:mac": "npm run build:frontend && electron-builder --mac",
    "electron:build:win": "npm run build:frontend && electron-builder --win",
    "electron:build:linux": "npm run build:frontend && electron-builder --linux"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "caniuse-lite": "^1.0.30001735",
    "date-fns": "^4.1.0",
    "ogl": "^1.0.11",
    "react-hook-form": "^7.56.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^17.5.6",
    "happy-dom": "^17.5.6",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
