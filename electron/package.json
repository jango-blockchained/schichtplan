{
  "name": "schichtplan-desktop",
  "version": "1.0.0",
  "description": "Desktop application for Schichtplan scheduling system",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:backend": "cd ../src/backend && python -m src.backend.run runserver --port 5000",
    "dev:frontend": "cd ../src/frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend && electron-builder",
    "build:frontend": "cd ../src/frontend && npm install --legacy-peer-deps && npm run build",
    "build:backend": "python -m PyInstaller --onefile --add-data \"../src/backend:backend\" ../src/backend/run.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.schichtplan.desktop",
    "productName": "Schichtplan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/",
        "to": "backend/"
      },
      {
        "from": "../src/frontend/dist/",
        "to": "frontend/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "find-free-port": "^2.0.0",
    "tree-kill": "^1.2.2"
  }
}
